# Copy to .env. Development defaults to demo; hardware mode must be explicit.
MODE=demo
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Development defaults to http://localhost:5173; Docker Compose defaults to port 3001.
# APP_ORIGIN=http://localhost:5173
# Optional: otherwise a one-time setup token is printed on first startup.
# SETUP_TOKEN=replace-with-a-long-random-token-at-least-24-characters
# Set true behind HTTPS (required for internet-facing deployments).
COOKIE_SECURE=false
# Local CUPS only. Docker provides its own scheduler.
CUPS_SERVER=localhost:631
