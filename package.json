{
  "name": "openwebprint",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @openwebprint/server\" \"npm run dev -w @openwebprint/client\"",
    "build": "npm run typecheck && npm run build -w @openwebprint/client && npm run build -w @openwebprint/server",
    "typecheck": "tsc --noEmit -p apps/server && tsc --noEmit -p apps/client",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@sealsystems/ipp": {
      "moment": "^2.31.0"
    }
  }
}
